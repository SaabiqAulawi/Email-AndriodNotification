<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="Email to WhatsApp" android:textSize="24sp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="The app checks unread email in the background and shows a high-priority notification for each new message." android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingBottom="12dp" />
        <EditText android:id="@+id/imapHost" android:hint="IMAP host (e.g. imap.gmail.com)" android:inputType="textUri" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/username" android:hint="Email address" android:inputType="textEmailAddress" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/password" android:hint="App password" android:inputType="textPassword" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/start" android:text="Start monitoring" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        <Button android:id="@+id/stop" android:text="Stop monitoring" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
